SESSION_HMAC_KEY=replace-with-at-least-32-random-characters
RATE_LIMIT_HMAC_KEY=replace-with-at-least-32-random-characters
APP_SECRET_ARN=
READINGS_TABLE=tarot-dev-readings
CONTENT_TABLE=tarot-dev-content
RATE_LIMITS_TABLE=tarot-dev-rate-limits
AGENT_QUEUE_URL=
