NODE_ENV=development
PORT=4000
STORAGE_DRIVER=postgres
DATABASE_URL=postgres://tarot:tarot@localhost:5432/tarot
WEB_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
AI_MODE=mock
OPENAI_API_KEY=
SPREAD_MODEL=gpt-5.6-luna
READING_MODEL=gpt-5.6-terra
